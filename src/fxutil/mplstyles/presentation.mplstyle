# Keep the LaTeX packages and math support from tex.mplstyle.
font.family: sans-serif
font.sans-serif: Computer Modern Sans Serif, DejaVu Sans
font.size: 18
axes.titlesize: 22
axes.labelsize: 22
xtick.labelsize: 18
ytick.labelsize: 18
legend.fontsize: 18
figure.titlesize: 22

lines.linewidth: 2.8
lines.markersize: 8
axes.linewidth: 1.3
axes.spines.top: False
axes.spines.right: False
xtick.top: False
ytick.right: False
xtick.direction: out
ytick.direction: out
xtick.major.size: 6
ytick.major.size: 6
xtick.major.width: 1.3
ytick.major.width: 1.3
legend.frameon: False
legend.handlelength: 1.7
axes.grid: False
grid.alpha: 0.25
