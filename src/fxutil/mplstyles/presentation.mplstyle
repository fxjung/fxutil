# Keep the LaTeX packages and math support from tex.mplstyle.
font.family: sans-serif
font.sans-serif: Atkinson Hyperlegible Next, DejaVu Sans

# Mathematics: Computer Modern
text.usetex: False
mathtext.fontset: cm
font.size: 26
axes.titlesize: 30
axes.labelsize: 30
xtick.labelsize: 26
ytick.labelsize: 26
legend.fontsize: 26
figure.titlesize: 30

lines.linewidth: 3.2
lines.markersize: 9
axes.linewidth: 1.6
axes.spines.top: False
axes.spines.right: False
xtick.top: False
ytick.right: False
xtick.direction: out
ytick.direction: out
xtick.major.size: 7
ytick.major.size: 7
xtick.major.width: 1.6
ytick.major.width: 1.6
# Keep minor ticks subordinate, but visible at presentation scale.
xtick.minor.size: 4
ytick.minor.size: 4
xtick.minor.width: 1.1
ytick.minor.width: 1.1
lines.markeredgewidth: 1.2
errorbar.capsize: 3
legend.frameon: False
legend.handlelength: 1.7
axes.grid: False
grid.alpha: 0.25

# Compact spacing while retaining room for large labels (pads in inches).
figure.constrained_layout.w_pad: 0.06
figure.constrained_layout.h_pad: 0.06
axes.labelpad: 3
axes.titlepad: 5
legend.borderaxespad: 0.3
legend.labelspacing: 0.35
legend.handletextpad: 0.6
